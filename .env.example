APP_NAME=OpsPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opspilot
DB_USERNAME=opspilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- White-label defaults (each workspace can override in Settings → Branding)
BRAND_NAME=OpsPilot
BRAND_PRIMARY_COLOR="#4f46e5"
BRAND_SUPPORT_EMAIL=support@opspilot.test
BRAND_LOGO_MAX_KB=1024

# --- Demo mode: one-click private sandboxes + abuse and cost guards
DEMO_MODE=false
DEMO_SANDBOX_LIFETIME_HOURS=24
DEMO_SANDBOXES_PER_IP_PER_HOUR=5
DEMO_DAILY_AI_SPEND_CAP_USD=2.00
DEMO_AI_REQUESTS_PER_USER_PER_MINUTE=10
DEMO_AI_REQUESTS_PER_IP_PER_HOUR=60
DEMO_MAX_UPLOAD_KB=512
DEMO_MAX_FILES_PER_USER=5
DEMO_MAX_IMPORT_ROWS=50
# The permanent showcase workspace (restored nightly by demo:reset). Change the password!
DEMO_SHOWCASE_SLUG=oakline-home
DEMO_SHOWCASE_ADMIN_EMAIL=maya@oaklinehome.example
DEMO_SHOWCASE_AGENT_EMAIL=theo@oaklinehome.example
DEMO_SHOWCASE_PASSWORD=password

# --- AI provider (see config/ai.php). Switch providers by changing these lines only.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=low
ANTHROPIC_REFUSAL_FALLBACK=true
OPENAI_API_KEY=
# Anthropic has no embeddings API; use OpenAI for embeddings or leave both empty.
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
# Optional: override the price (USD per 1M tokens) of AI_MODEL.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
